<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodexComputerRunMCPServer</AssemblyName>
    <RootNamespace>CodexComputerRunMCPServer</RootNamespace>
    <PackageId>CP.CodexComputerRun.Mcp.Server</PackageId>
    <Title>Codex Computer Run MCP Server</Title>
    <Description>MCP server for Codex desktop control and general workstation automation: screenshots, mouse, keyboard, Unicode text entry, window discovery, semantic Windows UI Automation, graceful close, bounded filesystem organization, local Git workflows, process recovery, URL entry points, and a bundled Codex Skill. Windows uses native Win32 APIs; Linux and macOS use best-effort desktop command adapters.</Description>
    <Authors>Chris Pulman</Authors>
    <PackageProjectUrl>https://github.com/ChrisPulman/CodexComputerRunMCPServer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ChrisPulman/CodexComputerRunMCPServer</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Codex;MCP;Model Context Protocol;Windows;Linux;macOS;desktop automation;computer use;skill;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <ToolCommandName>codex-computer-run-mcp-server</ToolCommandName>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" Link="README.md" />
    <None Include="..\..\skills\codex-computer-run\**\*.*" Pack="true" PackagePath="skills\codex-computer-run\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" LinkBase="skills\codex-computer-run" />
  </ItemGroup>
  <Target Name="GenerateMcpPackageManifest" BeforeTargets="BeforeBuild;_GetPackageFiles" DependsOnTargets="MinVer">
    <PropertyGroup>
      <_McpManifestPath>$(IntermediateOutputPath)mcp/server.json</_McpManifestPath>
      <_McpManifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../.mcp/server.json'))</_McpManifest>
      <_McpManifest>$([System.Text.RegularExpressions.Regex]::Replace('$(_McpManifest)', '&quot;version&quot;\s*:\s*&quot;[^&quot;]*&quot;', '&quot;version&quot;: &quot;$(PackageVersion)&quot;'))</_McpManifest>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)mcp" />
    <!-- The default encoding is UTF-8 without a BOM. NuGet reads raw UTF-8 bytes as JSON. -->
    <WriteLinesToFile File="$(_McpManifestPath)" Lines="$(_McpManifest)" Overwrite="true" />
    <ItemGroup>
      <None Include="$(_McpManifestPath)" Pack="true" PackagePath=".mcp/server.json" Link=".mcp/server.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
